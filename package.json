{
    "name": "@luna-park/plugin-boilerplate",
    "version": "1.0.0",
    "private": false,
    "description": "Boilerplate plugin for Luna Park: a documented example of every plugin feature",
    "keywords": [
        "luna-park",
        "plugin",
        "boilerplate"
    ],
    "homepage": "https://luna-park.app",
    "repository": {
        "type": "git",
        "url": "https://github.com/lunapark/plugin-boilerplate"
    },
    "author": {
        "name": "Luna Park",
        "url": "https://luna-park.app"
    },
    "type": "module",
    "exports": {
        ".": {
            "import": "./dist/index.js"
        },
        "./runtime": {
            "import": "./dist/runtime.js"
        },
        "./server": {
            "import": "./dist/server.js"
        },
        "./shared": {
            "import": "./dist/shared.js"
        }
    },
    "module": "./dist/index.js",
    "files": [
        "dist/**",
        "src/logo.svg"
    ],
    "scripts": {
        "build": "vite build",
        "dev": "vite build --watch",
        "preview": "luna-preview",
        "typecheck": "vue-tsc -b",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix"
    },
    "dependencies": {
        "@fortawesome/free-solid-svg-icons": "^7.3.1",
        "vue": "^3.5.44"
    },
    "devDependencies": {
        "@luna-park/design": "^1.5.0",
        "@luna-park/eslint-config": "^1.4.5",
        "@luna-park/plugin": "^2.0.1",
        "@types/node": "^26.6.6",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vue/tsconfig": "^0.9.1",
        "eslint": "^10.13.0",
        "globals": "^17.13.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.5",
        "vite-plugin-css-injected-by-js": "^5.0.3",
        "vue-tsc": "^3.3.13"
    },
    "peerDependencies": {
        "@luna-park/design": "^1.4.0",
        "vue": "^3.5.43"
    }
}
